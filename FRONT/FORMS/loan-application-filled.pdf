               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>FOR VALUE RECEIVED, I hereby promised</photoshop:LayerName>
                  <photoshop:LayerText>FOR VALUE RECEIVED, I hereby promised</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Loan Renewal:   •Duly accomplished loan application  •Latest pa</photoshop:LayerName>
                  <photoshop:LayerText>Loan Renewal:   •Duly accomplished loan application  •Latest payslip                         •1 government issued I.D. of borrower (Photocopy)                •1 government issued I.D. of endorsing officer (Photocopy)</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>New Members with loan application:  •Duly accomplished Membersh</photoshop:LayerName>
                  <photoshop:LayerText>New Members with loan application:  •Duly accomplished Membership application  •Duly accomplished loan application  •Latest payslip                         •Appointment (Photocopy)  •1 government issued I.D. of borrower (Photocopy)                •1 government issued I.D. of endorsing officer (Photocopy)</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>ATTACHMENTS:</photoshop:LayerName>
                  <photoshop:LayerText>ATTACHMENTS:</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>NOTES:       1. Only SCSLAI member can sign as Co-Makers.      </photoshop:LayerName>
                  <photoshop:LayerText>NOTES:       1. Only SCSLAI member can sign as Co-Makers.       2. For Rank in file employees, at least 10 co-makers except for Maxi loans, Business loans, HELP, Housing         Asst. Loan  (HAL) 15 co-makers.       3. Your payslip serves as your SCSLAI receipt.       4. Delivery of Loan Proceeds will auto credit to ATM account payroll (LBP)                    </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>proper trial court witht Jurisdiction in the City of Manila.</photoshop:LayerName>
                  <photoshop:LayerText>proper trial court witht Jurisdiction in the City of Manila.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
